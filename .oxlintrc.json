{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["react", "typescript", "unicorn", "oxc"],
    "categories": {
        "correctness": "error"
    },
    "rules": {
        "react-hooks/exhaustive-deps": "warn",
        "react/react-compiler": "warn"
    },
    "env": {
        "builtin": true,
        "browser": true
    }
}
