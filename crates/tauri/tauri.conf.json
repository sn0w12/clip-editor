{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Seraphis",
    "version": "0.5.0",
    "identifier": "com.sn0w12.seraphis",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:3000",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../../dist",
        "removeUnusedCommands": true
    },
    "app": {
        "withGlobalTauri": false,
        "windows": [
            {
                "title": "Seraphis",
                "width": 1400,
                "height": 900,
                "minWidth": 960,
                "minHeight": 640,
                "center": true,
                "resizable": true,
                "decorations": false,
                "visible": false,
                "backgroundColor": "#0a0a0a",
                "additionalBrowserArgs": "--enable-experimental-web-platform-features"
            }
        ],
        "security": {
            "csp": null,
            "assetProtocol": {
                "enable": true,
                "scope": ["**"]
            }
        }
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlDNDg2QUZFNTFGOTExRTAKUldUZ0VmbFIvbXBJbkRNZXZjL3NFZG5OeGNQSURKbk1nQXJZWmh4L0tpbEg2cThCZDRDcHpPK3oK",
            "endpoints": [
                "https://github.com/sn0w12/clip-editor/releases/latest/download/latest.json"
            ]
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "createUpdaterArtifacts": true,
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
